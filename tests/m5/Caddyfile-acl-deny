{
	admin off
	debug
	grace_period 1s
	auto_https disable_redirects
}

https://127.0.0.1:{$M5_PROXY_PORT} {
	tls internal
	log {
		output file {env.M5_ACCESS_LOG}
		format json
	}
	route {
		forward_proxy {
			basic_auth m5-user m5-pass
			acl {
				deny m5-policy.localhost
				allow 127.0.0.1/32 ::1/128
				allow all
			}
		}
		respond "camouflage"
	}
}
