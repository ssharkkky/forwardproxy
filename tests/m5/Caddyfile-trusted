{
	admin off
	debug
	grace_period 1s
}

https://m5-proxy.localhost:{$M5_PROXY_PORT} {
	tls {env.M5_SERVER_CERT} {env.M5_SERVER_KEY}
	log {
		output file {env.M5_ACCESS_LOG}
		format json
	}
	route {
		forward_proxy {
			basic_auth m5-user m5-pass
			acl {
				allow 127.0.0.1/32 ::1/128
				allow all
			}
		}
		respond "camouflage"
	}
}
